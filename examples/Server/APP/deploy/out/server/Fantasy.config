<?xml version="1.0" encoding="utf-8" ?>
<!-- ============================================================================
     外网部署版配置（Linux + WebSocket + MongoDB 同机）
     与 Entity/Fantasy.config 的差异：
       1. machine 的 outerIP/outerBindIP 改为外网部署填法（占位符 121.199.24.31）
       2. 未使用的对外 Gate（KCP 20000）与 HttpGift（HTTP 20010）已注释，只保留 WebSocket
     部署时 deploy.sh 会把 121.199.24.31 替换为真实公网 IP 后覆盖到发布目录。
     若手动部署：把 121.199.24.31 改成你的公网 IP，再把本文件拷成发布目录里的 Fantasy.config。
     ============================================================================ -->
<fantasy xmlns="http://fantasy.net/config"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://fantasy.net/config Fantasy.xsd">

  <idFactory type="Default"/>
  <network inner="TCP" maxMessageSize="1048560" />
  <session idleTimeout="8000" idleInterval="5000" />
  <server>
    <!-- 机器配置：
         outerIP     = 公网IP（下发给客户端）
         outerBindIP = 监听所有网卡。注意 WebSocket 走 .NET HttpListener，Linux 下
                       不接受 "0.0.0.0" 字面量（HttpListenerException 50），必须用 "+"。
                       （若改用 TCP/KCP，则应填 "0.0.0.0"，因为 Socket.Bind 不认 "+"）
         innerBindIP = 127.0.0.1（单机内部通讯） -->
    <machines>
      <machine id="1" outerIP="121.199.24.31" outerBindIP="+" innerBindIP="127.0.0.1" />
    </machines>

    <!-- 进程配置 -->
    <processes>
      <process id="1" machineId="1" startupGroup="1" />
    </processes>

    <!-- 世界配置：MongoDB 同机，连接串走回环 -->
    <worlds>
      <world id="1" worldName="WorldA">
        <database dbType="MongoDB" dbName="fantasy_main1" dbConnection="mongodb://127.0.0.1:27017/"/>
        <database dbType="MongoDB" dbName="fantasy_main2" dbConnection="mongodb://127.0.0.1:27017/"/>
        </world>
      <world id="2" worldName="WorldB">
        <database dbType="MongoDB" dbName="doc" dbConnection=""/>
      </world>
    </worlds>

    <!-- 场景配置 -->
    <scenes>
      <scene id="1001" processConfigId="1" worldConfigId="1" sceneRuntimeMode="MultiThread"
             sceneTypeString="Addressable" networkProtocol="" outerPort="0" innerPort="11001"/>
      <!-- KCP Gate 未使用（只用 WebSocket），已注释 -->
      <!--<scene id="1002" processConfigId="1" worldConfigId="1" sceneRuntimeMode="MultiThread"
             sceneTypeString="Gate" networkProtocol="KCP" outerPort="20000" innerPort="11002"/>-->
      <scene id="1007" processConfigId="1" worldConfigId="1" sceneRuntimeMode="MultiThread"
             sceneTypeString="Gate" networkProtocol="WebSocket" outerPort="20001" innerPort="11007"/>
      <scene id="1003" processConfigId="1" worldConfigId="1" sceneRuntimeMode="MultiThread"
             sceneTypeString="Map" networkProtocol="" outerPort="0" innerPort="11003"/>
      <scene id="1004" processConfigId="1" worldConfigId="1" sceneRuntimeMode="MultiThread"
             sceneTypeString="Chat" networkProtocol="" outerPort="0" innerPort="11004"/>
      <!-- HttpGift 未使用，已注释；如需礼包 HTTP 接口，取消注释并放行 20010/tcp -->
      <!--<scene id="1006" processConfigId="1" worldConfigId="1" sceneRuntimeMode="MultiThread"
             sceneTypeString="HttpGift" networkProtocol="HTTP" outerPort="20010" innerPort="11006"/>-->
      <scene id="2001" processConfigId="1" worldConfigId="2" sceneRuntimeMode="MultiThread"
             sceneTypeString="Map" networkProtocol="" outerPort="0" innerPort="11005"/>
    </scenes>
  </server>
</fantasy>
