<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>default</LangVersion>
        <!-- Luban 运行时 ByteBuf 使用 unsafe 指针读写定长数值/向量(Float/Double/Vector*/Matrix4x4)。 -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DefineConstants>TRACE;FANTASY_NET</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DefineConstants>TRACE;FANTASY_NET</DefineConstants>
    </PropertyGroup>

    <PropertyGroup>
      <!-- SG调试输出避免被编译器升级为Error -->
      <WarningsNotAsErrors>$(WarningsNotAsErrors);DebugFantasySG</WarningsNotAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\..\Fantasy.Packages\Fantasy.Net\Fantasy.Net.csproj" />
        <ProjectReference Include="..\..\ThirdParty\DotRecast\DotRecast.Detour\DotRecast.Detour.csproj" />
        <ProjectReference Include="..\..\ThirdParty\DotRecast\DotRecast.Recast\DotRecast.Recast.csproj" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\..\..\..\Fantasy.Packages\Fantasy.SourceGenerator\Fantasy.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup>
      <None Update="NLog.config">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="NLog.xsd">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Fantasy.xsd">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>
    <!-- Luban 服务端配置 .bytes 由 gen_code_bin_to_server.bat 生成进 Generate\GameConfigBytes\,
         随构建复制到 Main bin 目录;运行期 GameConfigSystem 从进程工作目录的 GameConfigBytes\ 下加载。 -->
    <ItemGroup>
      <None Include="Generate\GameConfigBytes\**\*.bytes">
        <Link>GameConfigBytes\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="NLog" Version="6.1.3" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Functional Examples\" />
      <Folder Include="Generate\NetworkProtocol\" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="Fantasy.config" />
      <AdditionalFiles Include="Fantasy.config">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </AdditionalFiles>
    </ItemGroup>
</Project>
